<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SportsClipBot - Compliance &amp; Publishing Control Center</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background-color: #0b0f19; color: #f1f5f9; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    .card { background-color: #1e293b; border: 1px solid #334155; border-radius: 12px; margin-bottom: 1.5rem; }
    .card-header { background-color: #111827; border-bottom: 1px solid #334155; font-weight: 700; color: #38bdf8; }
    .badge-pass { background-color: #10b981; color: #fff; }
    .badge-fail { background-color: #ef4444; color: #fff; }
    .badge-pending { background-color: #f59e0b; color: #000; }
    .table { color: #f1f5f9; }
    .table-dark { --bs-table-bg: #1e293b; }
    .btn-approve { background-color: #10b981; border: none; font-weight: 600; }
    .btn-approve:hover { background-color: #059669; }
    .btn-reject { background-color: #ef4444; border: none; font-weight: 600; }
    .btn-reject:hover { background-color: #dc2626; }
    .stat-box { padding: 1.25rem; border-radius: 10px; background-color: #1e293b; border-left: 5px solid #38bdf8; }
  </style>
</head>
<body>
  <nav class="navbar navbar-dark bg-dark border-bottom border-secondary px-4 py-3">
    <div class="container-fluid">
      <span class="navbar-brand mb-0 h1 fs-4">
        ⚡ <strong>SportsClipBot</strong> <span class="text-info fs-6">| Monetization Compliance Gate</span>
      </span>
      <div>
        <% if (isPaused) { %>
          <span class="badge bg-danger p-2 me-2">🚨 PIPELINE PAUSED: <%= pauseReason %></span>
          <form action="/api/pipeline/resume" method="POST" class="d-inline">
            <button class="btn btn-outline-success btn-sm">▶ Resume Pipeline</button>
          </form>
        <% } else { %>
          <span class="badge bg-success p-2 me-2">● Pipeline Active</span>
          <form action="/api/pipeline/pause" method="POST" class="d-inline">
            <button class="btn btn-outline-warning btn-sm">⏸ Pause Pipeline</button>
          </form>
        <% } %>
        <form action="/api/pipeline/trigger" method="POST" class="d-inline ms-2">
          <button class="btn btn-primary btn-sm">⚡ Run Ingest Now</button>
        </form>
        <a href="/news-dashboard" class="btn btn-outline-info btn-sm ms-2">📰 News Automation Dashboard</a>
      </div>
    </div>
  </nav>

  <div class="container-fluid px-4 py-4">
    <!-- Top Stats Bar -->
    <div class="row g-3 mb-4">
      <div class="col-md-3">
        <div class="stat-box" style="border-left-color: #f59e0b;">
          <div class="text-secondary small fw-bold">PENDING APPROVAL</div>
          <div class="fs-2 fw-bold text-warning"><%= pendingApprovals.length %></div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="stat-box" style="border-left-color: #10b981;">
          <div class="text-secondary small fw-bold">PUBLISHED TODAY (YOUTUBE)</div>
          <div class="fs-2 fw-bold text-success"><%= youtubePublishedToday %> / <%= dailyCap %></div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="stat-box" style="border-left-color: #38bdf8;">
          <div class="text-secondary small fw-bold">PUBLISHED TODAY (FACEBOOK)</div>
          <div class="fs-2 fw-bold text-info"><%= facebookPublishedToday %> / <%= dailyCap %></div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="stat-box" style="border-left-color: #ef4444;">
          <div class="text-secondary small fw-bold">MONITORING STRIKES/CLAIMS</div>
          <div class="fs-2 fw-bold text-danger"><%= monitoringEvents.length %></div>
        </div>
      </div>
    </div>

    <!-- Mandatory Review Queue -->
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span>📋 Mandatory Human Approval Queue (<%= pendingApprovals.length %> awaiting review)</span>
        <small class="text-secondary">Strict Gate: No video is published without human approval</small>
      </div>
      <div class="card-body">
        <% if (pendingApprovals.length === 0) { %>
          <p class="text-muted my-3 text-center">No videos currently awaiting approval. Ingested clips will appear here once processed and cleared by the compliance gate.</p>
        <% } else { %>
          <div class="row g-4">
            <% pendingApprovals.forEach(function(item) { %>
              <div class="col-lg-6">
                <div class="card bg-dark border-secondary p-3">
                  <div class="d-flex justify-content-between align-items-start mb-2">
                    <h5 class="card-title text-light"><%= item.title %></h5>
                    <span class="badge bg-warning text-dark">PENDING</span>
                  </div>
                  
                  <div class="small text-secondary mb-3">
                    <strong>Duration:</strong> <%= Math.round(item.duration) %>s | 
                    <strong>Original Ratio:</strong> <span class="text-info"><%= Math.round(item.originality_ratio * 100) %>%</span> |
                    <strong>License:</strong> <span class="badge bg-primary"><%= item.license_type %></span>
                  </div>

                  <div class="p-2 mb-3 rounded" style="background-color: #111827; border: 1px solid #1e293b;">
                    <div class="small fw-bold text-success mb-1">🛡 Compliance Gate Report:</div>
                    <div class="small text-light"><%= item.compliance_summary %></div>
                    <div class="small text-muted mt-1">
                      <strong>License Proof:</strong> <a href="<%= item.license_proof_url %>" target="_blank" class="text-info"><%= item.license_proof_url %></a>
                    </div>
                  </div>

                  <div class="mb-3">
                    <label class="form-label small text-secondary fw-bold">Narration / Commentary Script:</label>
                    <p class="small text-light fst-italic p-2 rounded bg-black">"<%= item.script %>"</p>
                  </div>

                  <div class="d-flex gap-2">
                    <form action="/api/approvals/<%= item.video_id %>/approve" method="POST" class="flex-grow-1">
                      <button type="submit" class="btn btn-approve text-white w-100 py-2">
                        ✅ Approve &amp; Publish
                      </button>
                    </form>
                    <form action="/api/approvals/<%= item.video_id %>/reject" method="POST" class="flex-grow-1">
                      <button type="submit" class="btn btn-reject text-white w-100 py-2">
                        ❌ Reject
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Published Posts & Rejections row -->
    <div class="row">
      <div class="col-lg-6">
        <div class="card">
          <div class="card-header">🚀 Recently Published Posts (<%= publishedPosts.length %>)</div>
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-dark table-hover mb-0">
                <thead>
                  <tr>
                    <th>Platform</th>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Published At</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (publishedPosts.length === 0) { %>
                    <tr><td colspan="4" class="text-center text-muted py-3">No posts published yet.</td></tr>
                  <% } else { %>
                    <% publishedPosts.forEach(function(post) { %>
                      <tr>
                        <td><span class="badge <%= post.platform === 'YOUTUBE' ? 'bg-danger' : 'bg-primary' %>"><%= post.platform %></span></td>
                        <td>
                          <a href="<%= post.external_url || '#' %>" target="_blank" class="text-light text-decoration-none">
                            <%= post.title || post.video_id %>
                          </a>
                        </td>
                        <td>
                          <span class="badge <%= post.status === 'SUCCESS' ? 'badge-pass' : 'badge-pending' %>">
                            <%= post.status %>
                          </span>
                        </td>
                        <td class="small text-secondary"><%= new Date(post.published_at).toLocaleString() %></td>
                      </tr>
                    <% }); %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-6">
        <div class="card">
          <div class="card-header text-danger">⚠️ Rejected Clips &amp; Non-Compliant Items</div>
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-dark table-hover mb-0">
                <thead>
                  <tr>
                    <th>Title</th>
                    <th>Source</th>
                    <th>Status</th>
                    <th>License</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (rejectedClips.length === 0) { %>
                    <tr><td colspan="4" class="text-center text-muted py-3">No rejected clips.</td></tr>
                  <% } else { %>
                    <% rejectedClips.forEach(function(clip) { %>
                      <tr>
                        <td class="text-light"><%= clip.title %></td>
                        <td class="small text-secondary"><%= clip.sourceName %></td>
                        <td><span class="badge badge-fail"><%= clip.status %></span></td>
                        <td class="small"><%= clip.licenseType %></td>
                      </tr>
                    <% }); %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Audit Log -->
    <div class="card mt-2">
      <div class="card-header">📜 Compliance &amp; Pipeline Audit Log</div>
      <div class="card-body p-0">
        <div class="table-responsive" style="max-height: 320px; overflow-y: auto;">
          <table class="table table-dark table-striped table-sm mb-0">
            <thead>
              <tr>
                <th>Time</th>
                <th>Entity</th>
                <th>ID</th>
                <th>Action</th>
                <th>Actor</th>
                <th>Details</th>
              </tr>
            </thead>
            <tbody>
              <% auditLogs.forEach(function(log) { %>
                <tr>
                  <td class="small text-muted"><%= new Date(log.created_at).toLocaleTimeString() %></td>
                  <td><span class="badge bg-secondary"><%= log.entity_type %></span></td>
                  <td class="small font-monospace"><%= log.entity_id %></td>
                  <td><span class="badge bg-dark border border-secondary"><%= log.action %></span></td>
                  <td class="small"><%= log.actor %></td>
                  <td class="small text-secondary"><%= log.details || '-' %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </div>
</body>
</html>
