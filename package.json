{
  "name": "fb-automation",
  "version": "1.0.0",
  "description": "Self-hosted news-to-Facebook automation platform with Playwright rendering & Bangla font support",
  "main": "dist/src/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs'); if(fs.existsSync('src/templates')){fs.cpSync('src/templates','dist/src/templates',{recursive:true})}\"",
    "start": "node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "download-fonts": "node -e \"require('./dist/scripts/download-fonts.js')\"",
    "test:rss": "tsx test/test-rss.ts",
    "test:renderer": "tsx test/test-renderer.ts",
    "test:facebook": "tsx test/test-facebook.ts",
    "test:queue": "tsx test/test-queue.ts",
    "test:pipeline": "tsx test/test-end-to-end.ts"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@napi-rs/canvas": "^1.1.0",
    "@vercel/functions": "^3.10.6",
    "cheerio": "^1.1.2",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "fluent-ffmpeg": "^2.1.3",
    "handlebars": "^4.7.8",
    "mongodb": "^7.8.0",
    "mysql2": "^3.24.6",
    "node-cron": "^3.0.3",
    "playwright": "^1.58.2",
    "playwright-core": "^1.64.1",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.1",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "optionalDependencies": {
    "@ffmpeg-installer/linux-x64": "^4.1.0"
  }
}
