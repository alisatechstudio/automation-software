    "sharp": "^0.35.5",
    "typescript": "^5.7.3",
    "undici": "^8.12.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
