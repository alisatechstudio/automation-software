{
  "name": "input-automation",
  "version": "1.0.0",
  "description": "Input Automation: Sourcing -> AI/TTS & Video Reel Rendering -> Google Drive Staging",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "run-now": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@napi-rs/canvas": "^1.1.0",
    "@vercel/functions": "^3.11.3",
    "cheerio": "^1.2.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^190.0.0",
    "https-proxy-agent": "^9.1.0",
    "mongodb": "^7.9.0",
    "node-edge-tts": "^1.2.12",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "rss-parser": "^3.13.0",
    "sharp": "^0.35.5",
    "undici": "^8.12.4",
    "ws": "^8.23.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^22.13.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "optionalDependencies": {
    "@ffmpeg-installer/linux-x64": "^4.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@ffmpeg-installer/win32-x64",
      "@ffprobe-installer/win32-x64",
      "@napi-rs/canvas",
      "sharp"
    ]
  }
}
