{
  "name": "fb-automation-workspace",
  "version": "2.0.0",
  "private": true,
  "description": "Two-Stage Automation Monorepo: 1. Input Automation (Source -> Reel -> Drive) & 2. Output Automation (Drive -> FB/YouTube/TikTok/Telegram)",
  "scripts": {
    "input:dev": "pnpm --filter input-automation dev",
    "input:build": "pnpm --filter input-automation build",
    "input:start": "pnpm --filter input-automation start",
    "input:run": "pnpm --filter input-automation run-now",
    "output:dev": "pnpm --filter output-automation dev",
    "output:build": "pnpm --filter output-automation build",
    "output:start": "pnpm --filter output-automation start",
    "output:publish": "pnpm --filter output-automation publish-now"
  }
}
