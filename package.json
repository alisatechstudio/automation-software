    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^22.13.1",
    "@types/node-cron": "^3.0.11",
    "@vercel/functions": "^3.11.3",
    "cheerio": "^1.2.0",
    "dotenv": "^16.6.1",
    "ejs": "^7.0.2",
    "express": "^4.22.1",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^190.0.0",
    "grammy": "^1.46.0",
    "mongodb": "^7.9.0",
    "node-cron": "^3.0.3",
    "node-edge-tts": "^1.2.12",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
