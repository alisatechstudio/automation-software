# ==============================================================================
# SportsClipBot Environment Variables
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=3000

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017
# Example for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=sports_clip_bot

# Safety Switch: Set to true to execute full sourcing, editing, and compliance gating
# without performing actual uploads to YouTube or Facebook
DRY_RUN=false

# ------------------------------------------------------------------------------
# 1. Anthropic Claude API (Scriptwriting & Advertiser-Friendliness Screening)
# ------------------------------------------------------------------------------
# Get key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-api-key-here

# ------------------------------------------------------------------------------
# 2. YouTube Data API v3 (Google Cloud OAuth2 Credentials)
# ------------------------------------------------------------------------------
# Follow docs/GOOGLE_OAUTH_SETUP.md to generate:
YOUTUBE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-your-google-client-secret
YOUTUBE_REFRESH_TOKEN=1//04your-long-lived-oauth2-refresh-token

# ------------------------------------------------------------------------------
# 3. Facebook Graph API (Meta for Developers - Reels Upload)
# ------------------------------------------------------------------------------
# Follow docs/FACEBOOK_APP_SETUP.md to generate:
FACEBOOK_PAGE_ID=your-facebook-page-numeric-id
FACEBOOK_PAGE_ACCESS_TOKEN=your-never-expiring-page-access-token

# ------------------------------------------------------------------------------
# 4. Telegram Approval Bot (grammY Interactive Approvals)
# ------------------------------------------------------------------------------
# Create bot via @BotFather on Telegram:
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# Get your numeric chat ID via @userinfobot:
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_ADMIN_USER_ID=12345678

# ------------------------------------------------------------------------------
# 5. AcoustID & Chromaprint (Commercial Audio Fingerprinting)
# ------------------------------------------------------------------------------
# Get free client API key from: https://acoustid.org/api-key
ACOUSTID_API_KEY=your_acoustid_client_api_key

# ------------------------------------------------------------------------------
# 6. Stock Licensed Video Sources (Pexels & Pixabay)
# ------------------------------------------------------------------------------
# Pexels: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here
# Pixabay: https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_api_key_here

# ------------------------------------------------------------------------------
# 7. Dashboard Security & Sessions
# ------------------------------------------------------------------------------
DASHBOARD_ADMIN_USER=admin
DASHBOARD_ADMIN_PASSWORD=change_this_strong_password_12345!
SESSION_SECRET=super_secure_random_hex_string_min_32_chars
