# ==============================================================================
# NEWS-TO-FACEBOOK AUTOMATION CONFIGURATION
# ==============================================================================

# Application Port & Environment
PORT=3000
NODE_ENV=production

# Admin Web Dashboard Security (Required for accessing UI and APIs)
ADMIN_PASSWORD=SetYourStrongPasswordHere_12345!

# Safety Switch: Set to true to test RSS ingestion, image rendering, and
# payload generation without publishing live posts to Facebook
DRY_RUN=false

# Polling Interval: Standard cron syntax (Default: every 10 minutes)
POLL_INTERVAL_CRON="*/10 * * * *"

# Deduplication Filter: Ignore articles older than X hours (Default: 24)
MAX_ARTICLE_AGE_HOURS=24

# Reliability & Anti-Spam Safeguards
MAX_POSTS_PER_HOUR=10
MIN_DELAY_SECONDS=30
MAX_DELAY_SECONDS=60

# Caption & Comment Formatting
# Available placeholders for caption: {headline}, {summary}, {hashtags}
# Notice: Facebook policies strictly penalize external links inside the photo caption!
DEFAULT_CAPTION_FORMAT="{headline}\n\n{summary}\n\n{hashtags}"
DEFAULT_HASHTAGS="#BreakingNews #Bangladesh #NewsUpdate"

# Available placeholders for first comment: {url}
DEFAULT_COMMENT_FORMAT="বিস্তারিত পড়ুন: {url}"

# Telegram Failure Alert Notifications (Optional)
# Create a bot with @BotFather and get your user/channel ID with @userinfobot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# Storage Locations (Defaults to /app/data and /app/assets in Docker)
DATABASE_PATH=./data/news_automation.db
DATA_DIR=./data
ASSETS_DIR=./assets

